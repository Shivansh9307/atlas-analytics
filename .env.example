# Atlas secrets — copy to .env (which is gitignored) and fill in.
# NEVER commit .env. Only NAMES live here.

# --- Optional in-script LLM shim (non-numeric use only) ---
# Atlas core reasoning runs inside Claude Code sub-agents and needs NO key.
# This key is only for optional scripted LLM-as-judge sanity checks.
OPENAI_API_KEY=
# Alternate provider (optional). If set and ATLAS_LLM_PROVIDER=anthropic, used instead.
ANTHROPIC_API_KEY=
# Provider selector: openai (default) | anthropic | none  (none = disable in-script LLM)
ATLAS_LLM_PROVIDER=openai

# --- Budgets (optional overrides; defaults in atlas/config.py) ---
# ATLAS_MAX_QUERIES=60
# ATLAS_MAX_BYTES_SCANNED=5000000000
# ATLAS_MAX_WALLCLOCK_S=1200

# --- Postgres (dormant until provided) — use a READ-ONLY role ---
PG_HOST=
PG_PORT=5432
PG_USER=
PG_PASSWORD=
PG_DATABASE=

# --- Snowflake (dormant) — use a READ-ONLY role/warehouse ---
SNOW_ACCOUNT=
SNOW_USER=
SNOW_PASSWORD=
SNOW_WAREHOUSE=
SNOW_DATABASE=
SNOW_ROLE=

# --- BigQuery (dormant) ---
GOOGLE_APPLICATION_CREDENTIALS=
BQ_PROJECT=

# --- Databricks (dormant) ---
DATABRICKS_SERVER_HOSTNAME=
DATABRICKS_HTTP_PATH=
DATABRICKS_TOKEN=
